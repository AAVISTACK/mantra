# Required
DATABASE_URL=postgres://user:pass@localhost:5432/mantra_db
REDIS_URL=redis://localhost:6379
JWT_SECRET=your-jwt-secret-minimum-32-characters-long
PHONE_HASH_SECRET=your-phone-hash-16chars

# Firebase (base64 of service account JSON)
FIREBASE_SERVICE_ACCOUNT_BASE64=

# AI Service
AI_SERVICE_URL=http://localhost:8001
AI_INTERNAL_SECRET=your-ai-internal-secret

# Optional
NODE_ENV=development
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:3000
